generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Client {
  id        String     @id @default(uuid())
  name      String
  phone     String
  email     String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  analyses  Analysis[] @relation("ClientAnalyses")
  formulas  Formula[]  @relation("ClientFormulas")
  visits    Visit[]    @relation("ClientVisits")

  @@index([name])
  @@index([phone])
}

model Formula {
  id              String   @id @default(uuid())
  currentLevel    Int      @default(1)
  currentTone     String   @default("n")
  targetLevel     Int      @default(1)
  targetTone      String   @default("n")
  condition       String   @default("virgin")
  grayPercentage  Int      @default(0)
  developerVolume Int      @default(20)
  processingTime  Int      @default(30)
  productBrand    String
  productLine     String
  productShade    String
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  clientId        String?
  client          Client?  @relation("ClientFormulas", fields: [clientId], references: [id])
  visits          Visit[]  @relation("FormulaVisits")

  @@index([productBrand])
  @@index([productLine])
  @@index([targetLevel])
  @@index([createdAt])
}

model Analysis {
  id                String   @id @default(uuid())
  level             Int      @default(1)
  tone              String   @default("n")
  underlyingPigment String   @default("Red")
  rgbR              Int      @default(0)
  rgbG              Int      @default(0)
  rgbB              Int      @default(0)
  confidence        Int      @default(80)
  imageUrl          String?
  createdAt         DateTime @default(now())
  clientId          String?
  client            Client?  @relation("ClientAnalyses", fields: [clientId], references: [id])

  @@index([level])
  @@index([tone])
  @@index([createdAt])
}

// ─── Formula History / Visit Records ─────────────────────────────────────────
model Visit {
  id            String    @id @default(uuid())
  clientId      String
  client        Client    @relation("ClientVisits", fields: [clientId], references: [id], onDelete: Cascade)
  formulaId     String?
  formula       Formula?  @relation("FormulaVisits", fields: [formulaId], references: [id], onDelete: SetNull)

  visitDate     DateTime  @default(now())
  serviceType   String?   // e.g. "Full Color", "Root Touch-up", "Highlights"
  notes         String?
  satisfaction  Int?      // 1-100 score

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([clientId])
  @@index([visitDate])
  @@index([formulaId])
}

model ColorBarSession {
  id          String   @id @default(cuid())
  salonId     String
  clientId    String?
  stylistId   String
  formulaId   String?
  status      String   // active, completed, cancelled
  steps       Json?    // [{ product, shadeCode, targetGrams, actualGrams }]
  totalCost   Float?
  squareOrderId String?
  createdAt   DateTime @default(now())
  completedAt DateTime?

  @@index([salonId])
  @@index([clientId])
  @@index([stylistId])
  @@index([status])
  @@index([createdAt])
}
