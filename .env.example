# ColorGenius Environment Variables

# JWT Secret (change in production!)
JWT_SECRET=colorgenius-dev-secret-change-in-prod

# API Base URL (for frontend and external calls)
API_BASE_URL=http://localhost:3001

# App Base URL (for frontend)
APP_BASE_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://colorgenius:colorgenius@db:5432/colorgenius

# Python Engine
PYTHON_ENGINE_URL=http://engine:8000

# File Uploads
UPLOAD_DIR=/uploads
MAX_UPLOAD_SIZE=20971520

# Redis
REDIS_URL=redis://redis:6379

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# CORS
CORS_ORIGIN=http://localhost:3000