{
  "name": "@colorgenius/mobile",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:android": "eas build --profile android",
    "build:ios": "eas build --profile ios",
    "build:web": "expo export:web",
