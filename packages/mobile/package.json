    "expo": "~50.0.0",
    "expo-constants": "~15.4.0",
    "expo-linking": "~6.2.0",
    "expo-router": "~3.4.0",
    "expo-status-bar": "~1.11.0",
    "expo-web-browser": "~12.8.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-native": "0.73.4",
    "react-native-web": "~0.19.6"
  },
  "devDependencies": {
    "expo-build-properties": "^55.0.14"
  }
