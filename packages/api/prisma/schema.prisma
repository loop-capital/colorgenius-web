// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ────────────────────────────────────────────────
// Core: Staff / User identity
// ────────────────────────────────────────────────
model Staff {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  role      StaffRole @default(COLORIST)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  createdFormulas   Formula[]      @relation("FormulaCreatedBy")
  createdProducts   Product[]      @relation("ProductCreatedBy")
  stockTransactions StockTransaction[]
  usageLogs         UsageLog[]

  @@index([email])
  @@index([role])
  @@map("staff")
}

enum StaffRole {
  ADMIN
  MANAGER
  COLORIST
  ASSISTANT
}

// ────────────────────────────────────────────────
// Core: Clients
// ────────────────────────────────────────────────
model Client {
  id            String   @id @default(cuid())
  name          String
  email         String?  @unique
  phone         String?
  notes         String?
  hairProfile   Json?    @map("hair_profile")  // structured: level, porosity, condition, history

  // Relations
  visits        ClientVisit[]
  usages        ClientFormulaUsage[]
  usageLogs     UsageLog[]

  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([email])
  @@index([name])
  @@map("clients")
}

// ────────────────────────────────────────────────
// Core: Client Visits
// ────────────────────────────────────────────────
model ClientVisit {
  id            String      @id @default(cuid())

  clientId      String      @map("client_id")
  client        Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)

  // Service performed
  serviceType   ServiceType @map("service_type")

  // Formula used (if any)
  formulaId     String?     @map("formula_id")
  formula       Formula?    @relation(fields: [formulaId], references: [id])

  // Pricing
  priceCharged  Int         @map("price_charged")  // in cents

  // Context
  visitDate     DateTime    @default(now()) @map("visit_date")
  notes         String?

  // Audit
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  // Relations
  profitSnapshot ProfitSnapshot?

  @@index([clientId])
  @@index([visitDate])
  @@index([formulaId])
  @@index([serviceType])
  @@map("client_visits")
}

// ────────────────────────────────────────────────
// Core: Products (inventory items)
// ────────────────────────────────────────────────
model Product {
  id              String   @id @default(cuid())
  sku             String   @unique
  name            String
  description     String?
  brand           String
  line            String?  // e.g. "Igora Royal", "Color Touch"
  shadeCode       String?  @map("shade_code")
  shadeName       String?  @map("shade_name")
  sizeGrams       Int?     @map("size_grams")

  // Categorisation
  category        ProductCategory @default(COLOR)
  subcategory     String?

  // Stock tracking
  currentStock    Int      @default(0) @map("current_stock")
  minStockLevel   Int      @default(0) @map("min_stock_level")
  reorderPoint    Int      @default(0) @map("reorder_point")
  reorderQty      Int      @default(0) @map("reorder_qty")

  // Costing (last known)
  unitCostCents   Int?     @map("unit_cost_cents")

  // Status
  status          ProductStatus @default(ACTIVE)

  // Metadata
  barcode         String?
  supplier        String?
  supplierSku     String?  @map("supplier_sku")

  // Relations
  formulaLines    FormulaLine[]
  stockTransactions StockTransaction[]
  usageLogs       UsageLog[]
  purchaseOrderLines PurchaseOrderLine[]
  autoOrderLogs   AutoOrderLog[]

  // Auto-ordering fields
  reorderThreshold Float   @default(0) @map("reorder_threshold")
  reorderQuantity  Float   @default(0) @map("reorder_quantity")
  autoReorder      Boolean @default(false) @map("auto_reorder")
  supplierId       String? @map("supplier_id")
  supplier         Supplier? @relation(fields: [supplierId], references: [id])

  // Audit
  createdById     String?  @map("created_by_id")
  createdBy       Staff?   @relation("ProductCreatedBy", fields: [createdById], references: [id])
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([sku])
  @@index([brand])
  @@index([category])
  @@index([status])
  @@index([currentStock])
  @@index([barcode])
  @@index([shadeCode])
  @@index([supplierId])
  @@index([autoReorder])
  @@map("products")
}

enum ProductCategory {
  COLOR
  DEVELOPER
  TREATMENT
  TOOL
  ACCESSORY
  RETAIL
}

enum ProductStatus {
  ACTIVE
  DISCONTINUED
  PENDING
  ARCHIVED
}

// ────────────────────────────────────────────────
// Core: Formulas (client-specific colour recipes)
// ────────────────────────────────────────────────
model Formula {
  id              String   @id @default(cuid())
  name            String   // e.g. "Eiza - Root Melt 2025-05"

  // Hair state at time of formula
  hairLevel       Int?     @map("hair_level")
  hairPorosity    Porosity? @map("hair_porosity")
  hairCondition   HairCondition? @map("hair_condition")
  previousColor   String?  @map("previous_color")

  // Formula metadata
  targetResult    String   @map("target_result")
  notes           String?

  // Relations
  lines           FormulaLine[]
  usageLogs       UsageLog[]
  clientUsages    ClientFormulaUsage[]
  clientVisits    ClientVisit[]

  // Audit
  createdById     String   @map("created_by_id")
  createdBy       Staff    @relation("FormulaCreatedBy", fields: [createdById], references: [id])
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([createdById])
  @@index([createdAt])
  @@map("formulas")
}

enum Porosity {
  LOW
  MEDIUM
  HIGH
}

enum HairCondition {
  HEALTHY
  DAMAGED
  COMPROMISED
}

// ────────────────────────────────────────────────
// Formula lines (ingredients within a formula)
// ────────────────────────────────────────────────
model FormulaLine {
  id          String   @id @default(cuid())

  formulaId   String   @map("formula_id")
  formula     Formula  @relation(fields: [formulaId], references: [id], onDelete: Cascade)

  productId   String   @map("product_id")
  product     Product  @relation(fields: [productId], references: [id])

  // Mix specifics
  amountGrams Int      @map("amount_grams")
  developerVol  String?  @map("developer_vol") // e.g. "10vol", "20vol"
  ratio       String?  // e.g. "1:1", "1:2"
  processingTimeMin Int? @map("processing_time_min")

  // Ordering within formula
  sortOrder   Int      @default(0) @map("sort_order")
  notes       String?

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([formulaId, sortOrder])
  @@index([formulaId])
  @@index([productId])
  @@map("formula_lines")
}

// ────────────────────────────────────────────────
// Client Formula Usage — tracks every time a formula is used on a client
// ────────────────────────────────────────────────
model ClientFormulaUsage {
  id              String   @id @default(cuid())

  // Who
  clientId        String   @map("client_id")
  clientName      String   @map("client_name")
  client          Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  // What formula was used
  formulaId       String   @map("formula_id")
  formula         Formula  @relation(fields: [formulaId], references: [id], onDelete: Cascade)

  // When / context
  usedAt          DateTime @default(now()) @map("used_at")
  appointmentId   String?  @map("appointment_id")

  // Staff who applied
  staffId         String   @map("staff_id")

  // Product usage records linked to this formula application
  usageLogs       UsageLog[]

  // Optional outcome / review
  outcomeRating   Int?     @map("outcome_rating") // 1-5, null until rated
  outcomeNotes    String?  @map("outcome_notes")
  outcomeAt       DateTime? @map("outcome_at")

  // Any tweaks made at time of use
  notes           String?

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([clientId])
  @@index([formulaId])
  @@index([usedAt])
  @@index([staffId])
  @@map("client_formula_usages")
}

// ────────────────────────────────────────────────
// Usage logs (track product consumed in service)
// ────────────────────────────────────────────────
model UsageLog {
  id              String   @id @default(cuid())

  // When / who
  staffId         String   @map("staff_id")
  staff           Staff    @relation(fields: [staffId], references: [id])
  usedAt          DateTime @default(now()) @map("used_at")

  // What
  productId       String   @map("product_id")
  product         Product  @relation(fields: [productId], references: [id])

  amountGrams     Int      @map("amount_grams")

  // Context
  formulaId       String?  @map("formula_id")
  formula         Formula? @relation(fields: [formulaId], references: [id])

  clientId        String?  @map("client_id")
  clientName      String?  @map("client_name")
  client          Client?  @relation(fields: [clientId], references: [id])
  appointmentId   String?  @map("appointment_id")

  // Link to ClientFormulaUsage when usage is part of a formula application
  clientFormulaUsageId String? @map("client_formula_usage_id")
  clientFormulaUsage  ClientFormulaUsage? @relation(fields: [clientFormulaUsageId], references: [id])

  // Cost snapshot (at time of usage)
  unitCostCentsAtUse Int?  @map("unit_cost_cents_at_use")

  notes           String?

  @@index([staffId])
  @@index([productId])
  @@index([usedAt])
  @@index([formulaId])
  @@index([clientId])
  @@index([clientFormulaUsageId])
  @@map("usage_logs")
}

// ────────────────────────────────────────────────
// Stock transactions (audit trail of all inventory movements)
// ────────────────────────────────────────────────
model StockTransaction {
  id              String   @id @default(cuid())

  productId       String   @map("product_id")
  product         Product  @relation(fields: [productId], references: [id])

  type            TransactionType
  quantity        Int      // positive = in, negative = out

  // Running balance snapshot
  stockAfter      Int      @map("stock_after")

  // Source / reference
  referenceType   String?  @map("reference_type") // e.g. "usage", "purchase_order", "adjustment", "waste"
  referenceId     String?  @map("reference_id")

  // Who & when
  staffId         String?  @map("staff_id")
  staff           Staff?   @relation(fields: [staffId], references: [id])

  // Cost (when applicable)
  unitCostCents   Int?     @map("unit_cost_cents")

  notes           String?
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([productId])
  @@index([type])
  @@index([createdAt])
  @@index([referenceType, referenceId])
  @@index([staffId])
  @@map("stock_transactions")
}

enum TransactionType {
  PURCHASE
  USAGE
  ADJUSTMENT
  WASTE
  RETURN
  TRANSFER
}

// ────────────────────────────────────────────────
// Service Pricing
// ────────────────────────────────────────────────
enum ServiceType {
  FULL_COLOR
  RETOUCH
  HIGHLIGHTS
  BALAYAGE
  CORRECTION
  GLOSS
  TONER
}

model ServicePricing {
  id          String      @id @default(cuid())
  serviceType ServiceType @unique @map("service_type")
  basePrice   Int         @map("base_price")          // base price in cents
  pricePerOz  Int?        @map("price_per_oz")         // optional upcharge per oz of product used
  updatedAt   DateTime    @updatedAt @map("updated_at")

  @@index([serviceType])
  @@map("service_pricing")
}

// ────────────────────────────────────────────────
// Profit Snapshots — per-visit P&L for salon services
// ────────────────────────────────────────────────
model ProfitSnapshot {
  id          String   @id @default(cuid())

  visitId     String   @unique @map("visit_id")
  visit       ClientVisit @relation(fields: [visitId], references: [id])

  revenue     Int                             // total service revenue in cents
  productCost Int      @map("product_cost")   // total product COGS in cents
  laborCost   Int?     @map("labor_cost")     // optional labor cost in cents
  profit      Int                             // revenue - productCost - laborCost
  margin      Float                           // profit / revenue as decimal (0.0-1.0)

  createdAt   DateTime @default(now()) @map("created_at")

  @@index([visitId])
  @@index([createdAt])
  @@map("profit_snapshots")
}

// ────────────────────────────────────────────────
// Purchase Orders (replenishment)
// ────────────────────────────────────────────────
model PurchaseOrder {
  id              String   @id @default(cuid())
  poNumber        String   @unique @map("po_number")

  supplier        String
  supplierRef     String?  @map("supplier_ref")

  status          PoStatus @default(DRAFT)

  // Dates
  orderedAt       DateTime? @map("ordered_at")
  expectedAt      DateTime? @map("expected_at")
  receivedAt      DateTime? @map("received_at")

  // Financials
  subtotalCents   Int      @default(0) @map("subtotal_cents")
  taxCents        Int      @default(0) @map("tax_cents")
  shippingCents   Int      @default(0) @map("shipping_cents")
  totalCents      Int      @default(0) @map("total_cents")

  // Relations
  lines           PurchaseOrderLine[]

  // Audit
  notes           String?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@index([orderedAt])
  @@index([supplier])
  @@map("purchase_orders")
}

enum PoStatus {
  DRAFT
  ORDERED
  PARTIAL
  RECEIVED
  CANCELLED
}

model PurchaseOrderLine {
  id              String   @id @default(cuid())

  purchaseOrderId String   @map("purchase_order_id")
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  productId       String   @map("product_id")
  product         Product  @relation(fields: [productId], references: [id])

  // Ordered
  qtyOrdered      Int      @map("qty_ordered")
  unitCostCents   Int      @map("unit_cost_cents")

  // Received
  qtyReceived     Int      @default(0) @map("qty_received")
  receivedAt      DateTime? @map("received_at")

  // Line total
  lineTotalCents  Int      @default(0) @map("line_total_cents")

  notes           String?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([purchaseOrderId])
  @@index([productId])
  @@map("purchase_order_lines")
}

// ────────────────────────────────────────────────
// Suppliers
// ────────────────────────────────────────────────
model Supplier {
  id            String   @id @default(cuid())
  name          String
  contactEmail  String?  @map("contact_email")
  contactPhone  String?  @map("contact_phone")
  website       String?
  leadTimeDays  Int?     @map("lead_time_days")
  notes         String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Relations
  products      Product[]
  autoOrderLogs AutoOrderLog[]

  @@index([name])
  @@map("suppliers")
}

// ────────────────────────────────────────────────
// Auto-order logs (generated when stock hits threshold)
// ────────────────────────────────────────────────
enum AutoOrderStatus {
  PENDING
  ORDERED
  RECEIVED
  CANCELLED
}

model AutoOrderLog {
  id              String          @id @default(cuid())

  productId       String          @map("product_id")
  product         Product         @relation(fields: [productId], references: [id], onDelete: Cascade)

  quantityOrdered Int             @map("quantity_ordered")

  supplierId      String          @map("supplier_id")
  supplier        Supplier        @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  purchaseOrderId String?         @map("purchase_order_id")

  triggeredAt     DateTime        @default(now()) @map("triggered_at")
  status          AutoOrderStatus @default(PENDING)

  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  @@index([productId])
  @@index([supplierId])
  @@index([purchaseOrderId])
  @@index([status])
  @@index([triggeredAt])
  @@map("auto_order_logs")
}

// ────────────────────────────────────────────────
// Seed data defaults for ServicePricing
//   FULL_COLOR = 8500   ($85.00)
//   RETOUCH    = 6500   ($65.00)
//   HIGHLIGHTS = 15000  ($150.00)
//   BALAYAGE   = 20000  ($200.00)
//   CORRECTION = 25000  ($250.00)
//   GLOSS      = 4500   ($45.00)
//   TONER      = 3500   ($35.00)
// ────────────────────────────────────────────────
