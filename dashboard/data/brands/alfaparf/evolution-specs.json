    "toneCodes": {
      "0": "natural / cool modifier",
      "1": "ash (blue base)",
      "2": "irisé (violet base)",
      "3": "gold (yellow base)",
      "4": "copper (orange base)",
      "5": "mahogany (red-violet base)",
      "6": "red (red base)",
      "7": "matte (green base)"
    },
    "rules": [
      "Single tone number = 100% that tone (e.g., 7.3 = Gold)",
      "Two different numbers = primary tone + secondary tone (e.g., 7.32 = Gold-Violet)",
      "Two identical numbers = Intense tone (e.g., 6.66I = Intense Red)",
      "0 in front of secondary tone = less intense (e.g., 7.01 = Cool Natural)"
    ]
