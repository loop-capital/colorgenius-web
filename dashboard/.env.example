DATABASE_URL="postgresql://postgres:postgres@localhost:5432/colorgenius?schema=public"

REDIS_URL=redis://localhost:6379
UPLOOK_API_KEY=
SQUARE_ACCESS_TOKEN=
SQUARE_WEBHOOK_SIGNATURE_KEY=
MODERATION_API_KEY=
# --- Monthly creator-tier recalc (Vercel Cron, 1st of month) ---
# Bearer token the cron job sends as Authorization header. Generate with:
#   openssl rand -base64 32
# Set the same value in the Vercel env dashboard (Production). CRON_SECRET
# must be non-empty in production or the endpoint only accepts admin JWTs.
CRON_SECRET=
