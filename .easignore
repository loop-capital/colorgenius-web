# Ignore everything by default
*

# Only include the ios-app directory
!ios-app/
!ios-app/**

# But still ignore node_modules within ios-app
ios-app/node_modules/
ios-app/.expo/
ios-app/dist/
ios-app/build/

# Ignore other large directories at root
node_modules/
.git/
.archive/
.next/
dist/
build/
packages/*/node_modules/
dashboard/node_modules/
landing-page/node_modules/
